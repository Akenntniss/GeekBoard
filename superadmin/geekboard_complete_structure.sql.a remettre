    UPDATE devis 
    SET total_ht = (
        SELECT SUM(prix_total) 
        FROM devis_solutions 
        WHERE devis_id = NEW.devis_id
    ),
    total_ttc = (
        SELECT SUM(prix_total) * (1 + taux_tva/100)
        FROM devis_solutions 
        WHERE devis_id = NEW.devis_id
    )
    WHERE id = NEW.devis_id$$
DELIMITER ;

